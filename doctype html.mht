 18px rgba(15,40,80,.08); user-select:none; transition: transform .12s ease, border-color .12s ease, outline .12s ease; display:flex; align-items:center; justify-content:center; gap:8px; min-height: 48px; } .opt .emoji{ font-size: 18px; } .opt:active{transform: scale(.99)} .opt.active{ border-color: rgba(47,128,255,.95); outline: 2px solid rgba(47,128,255,.18); } .toast{ position: fixed; left:50%; bottom: 22px; transform: translateX(-50%); background: rgba(10,22,40,.92); color:#fff; padding: 10px 12px; border-radius: 999px; font-size: 13px; opacity: 0; pointer-events:none; transition: opacity .2s ease, transform .2s ease; z-index: 50; } .toast.show{ opacity:1; transform: translateX(-50%) translateY(-6px); } .progress{ margin-top: 10px; display:flex; gap:6px; justify-content:center; } .dot{ width: 8px; height: 8px; border-radius: 999px; background: rgba(47,128,255,.25); } .dot.on{ background: rgba(47,128,255,.95); } /* 可爱小狗（纯CSS） */ .dogWrap{ position:absolute; right: 10px; top: 10px; width: 110px; height: 90px; opacity: .95; transform: rotate(2deg); pointer-events:none; filter: drop-shadow(0 14px 16px rgba(15,40,80,.14)); } .dog{ position:relative; width: 110px; height: 90px; } .dog .head{ position:absolute; left:18px; top:18px; width: 74px; height: 56px; background: #ffffff; border: 2px solid rgba(20,32,51,.10); border-radius: 24px; } .dog .ear{ position:absolute; width: 22px; height: 30px; background:#8ec7ff; border: 2px solid rgba(20,32,51,.10); border-radius: 18px; top: 12px; } .dog .ear.left{ left: 10px; transform: rotate(-18deg); } .dog .ear.right{ right: 10px; transform: rotate(18deg); } .dog .eye{ position:absolute; top: 22px; width: 8px; height: 8px; border-radius: 999px; background:#142033; } .dog .eye.left{ left: 24px; } .dog .eye.right{ right: 24px; } .dog .blush{ position:absolute; top: 32px; width: 10px; height: 6px; border-radius: 999px; background: rgba(105,183,255,.55); filter: blur(.2px); } .dog .blush.left{ left: 14px; } .dog .blush.right{ right: 14px; } .dog .snout{ position:absolute; left: 24px; top: 30px; width: 26px; height: 18px; background: #f3f7ff; border: 2px solid rgba(20,32,51,.08); border-radius: 14px; } .dog .nose{ position:absolute; left: 10px; top: 4px; width: 8px; height: 6px; border-radius: 999px; background:#142033; } .dog .mouth{ position:absolute; left: 8px; top: 10px; width: 10px; height: 6px; border: 2px solid rgba(20,32,51,.55); border-top: 0; border-left:0; border-right:0; border-radius: 0 0 10px 10px; opacity:.7; } .dog .tag{ position:absolute; left: 8px; bottom: 2px; background: linear-gradient(135deg, #2f80ff, #7c5cff); color:#fff; font-weight:800; font-size: 11px; padding: 6px 8px; border-radius: 999px; letter-spacing:.5px; } /* 蓝色爪印图案背景 */ .pawBg{ position:absolute; inset:-40px -40px -40px -40px; background: radial-gradient(circle at 12% 18%, rgba(47,128,255,.10) 0 7px, transparent 8px), radial-gradient(circle at 17% 12%, rgba(47,128,255,.10) 0 4px, transparent 5px), radial-gradient(circle at 7% 12%, rgba(47,128,255,.10) 0 4px, transparent 5px), radial-gradient(circle at 12% 8%, rgba(47,128,255,.10) 0 4px, transparent 5px), radial-gradient(circle at 78% 62%, rgba(47,128,255,.08) 0 7px, transparent 8px), radial-gradient(circle at 83% 56%, rgba(47,128,255,.08) 0 4px, transparent 5px), radial-gradient(circle at 73% 56%, rgba(47,128,255,.08) 0 4px, transparent 5px), radial-gradient(circle at 78% 52%, rgba(47,128,255,.08) 0 4px, transparent 5px); transform: rotate(-6deg); pointer-events:none; } /* 首页蓝色泡泡动画（替换原爱心动画，满足“动画”且更符合蓝色小狗风） */ .bubbles{ position:absolute; inset:0; overflow:hidden; pointer-events:none; border-radius: var(--radius); } .bubble{ position:absolute; width: 14px; height: 14px; border-radius: 999px; background: rgba(47,128,255,.22); border: 1px solid rgba(105,183,255,.35); animation: floatUp 5.2s linear infinite; filter: blur(.1px); } @keyframes floatUp{ 0%{ transform: translateY(35px); opacity:0; } 10%{opacity:1} 100%{ transform: translateY(-520px); opacity:0; } } .planCard{ background: #fff; border: 1px dashed rgba(47,128,255,.6); border-radius: 18px; padding: 14px 14px; margin-top: 12px; box-shadow: 0 12px 22px rgba(15,40,80,.08); } .kv{ display:flex; justify-content:space-between; gap:10px; padding: 8px 0; border-bottom: 1px solid rgba(0,0,0,.06); } .kv:last-child{ border-bottom:0; } .k{ color: var(--muted); font-size: 13px; } .v{ font-weight: 900; color:#17314d; } .smallLinks{ margin-top: 10px; display:flex; gap:10px; } .smallLinks button{ flex:1; padding: 10px 12px; border-radius: 14px; border:1px solid rgba(0,0,0,.08); background:#fff; cursor:pointer; font-weight: 900; color:#17314d; } .footerNote{ margin-top: 12px; font-size: 12px; color: rgba(75,96,122,.95); text-align:center; } .page{ display:none; } .page.on{ display:block; animation: pop .18s ease; } @keyframes pop{ from{ transform: translateY(6px); opacity:.0 } to{ transform: translateY(0); opacity:1 } } &lt;/style&gt; &lt;/head&gt; &lt;body&gt; &lt;div class=3D"wrap"&gt; &lt;div class=3D"topbar"&gt; &lt;div class=3D"pill" id=3D"titleTap"&gt;《我们的下一次约会》&lt;/div&gt; &lt;div class=3D"pill" id=3D"timer"&gt;2:00&lt;/div&gt; &lt;/div&gt; &lt;!-- Page 1 --&gt; &lt;div class=3D"page on" id=3D"p1"&gt; &lt;div class=3D"card"&gt; &lt;div class=3D"pawBg" aria-hidden=3D"true"&gt;&lt;/div&gt; &lt;div class=3D"dogWrap" aria-hidden=3D"true"&gt; &lt;div class=3D"dog"&gt; &lt;div class=3D"ear left"&gt;&lt;/div&gt; &lt;div class=3D"ear right"&gt;&lt;/div&gt; &lt;div class=3D"head"&gt; &lt;div class=3D"eye left"&gt;&lt;/div&gt; &lt;div class=3D"eye right"&gt;&lt;/div&gt; &lt;div class=3D"blush left"&gt;&lt;/div&gt; &lt;div class=3D"blush right"&gt;&lt;/div&gt; &lt;div class=3D"snout"&gt; &lt;div class=3D"nose"&gt;&lt;/div&gt; &lt;div class=3D"mouth"&gt;&lt;/div&gt; &lt;/div&gt; &lt;/div&gt; &lt;div class=3D"tag"&gt;小狗陪你&lt;/div&gt; &lt;/div&gt; &lt;/div&gt; &lt;div class=3D"bubbles" aria-hidden=3D"true" id=3D"bubbleBox"&gt;&lt;/div&gt; &lt;h1 id=3D"welcomeTitle"&gt;欢迎来到我们的专属约会计划&lt;/h1&gt; &lt;p&gt;这一次，让你来决定我们的约会方式。&lt;/p&gt; &lt;button class=3D"btn" id=3D"startBtn"&gt;开始定制我们的约会&lt;/button&gt; &lt;button class=3D"btn secondary" id=3D"openLetterBtn" style=3D"display:none;"&gt;打开隐藏情书&lt;/button&gt; &lt;div class=3D"progress" aria-hidden=3D"true"&gt; &lt;div class=3D"dot on"&gt;&lt;/div&gt;&lt;div class=3D"dot"&gt;&lt;/div&gt;&lt;div class=3D"dot"&gt;&lt;/div&gt;&lt;div class=3D"dot"&gt;&lt;/div&gt;&lt;div class=3D"dot"&gt;&lt;/div&gt; &lt;/div&gt; &lt;/div&gt; &lt;div class=3D"footerNote"&gt;提示：连续点击标题 5 次，会出现隐藏情书&lt;/div&gt; &lt;/div&gt; &lt;!-- Page 2 --&gt; &lt;div class=3D"page" id=3D"p2"&gt; &lt;div class=3D"card"&gt; &lt;h2&gt;你希望见到我的时间&lt;/h2&gt; &lt;p&gt;请选择 2026 年 9 月以后（可选月 / 日）。&lt;/p&gt; &lt;div class=3D"inputs"&gt; &lt;select id=3D"monthSel" aria-label=3D"选择月份"&gt;&lt;/select&gt; &lt;select id=3D"daySel" aria-label=3D"选择日期"&gt;&lt;/select&gt; &lt;/div&gt; &lt;button class=3D"btn" id=3D"saveDateBtn"&gt;点击确认时间（记录成功）&lt;/button&gt; &lt;button class=3D"btn secondary" id=3D"back1"&gt;返回&lt;/button&gt; &lt;div class=3D"progress" aria-hidden=3D"true"&gt; &lt;div class=3D"dot on"&gt;&lt;/div&gt;&lt;div class=3D"dot on"&gt;&lt;/div&gt;&lt;div class=3D"dot"&gt;&lt;/div&gt;&lt;div class=3D"dot"&gt;&lt;/div&gt;&lt;div class=3D"dot"&gt;&lt;/div&gt; &lt;/div&gt; &lt;/div&gt; &lt;/div&gt; &lt;!-- Page 3 --&gt; &lt;div class=3D"page" id=3D"p3"&gt; &lt;div class=3D"card"&gt; &lt;h2&gt;如果下次见面，你希望是什么样的感觉？&lt;/h2&gt; &lt;p&gt;选一个你最想要的氛围。&lt;/p&gt; &lt;div class=3D"grid" id=3D"themeOpts"&gt; &lt;div class=3D"opt" data-val=3D"浪漫仪式"&gt;&lt;span class=3D"emoji"&gt;</span><span style=3D"mso-spacerun:'yes';font-family:'Apple Color Emoji';color:rgb(0,0,0);=20letter-spacing:0.0000pt;text-transform:none;font-style:normal;=20font-size:10.5000pt;mso-font-kerning:0.0000pt;" ><font face=3D"Apple Color Emoji" >&#55357;&#56473;</font></span><span style=3D"mso-spacerun:'yes';font-family:-webkit-standard;color:rgb(0,0,0);=20letter-spacing:0.0000pt;text-transform:none;font-