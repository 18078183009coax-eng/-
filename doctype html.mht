&lt;div class=3D"page" id=3D"p5"&gt; &lt;div class=3D"card"&gt; &lt;h2&gt;我们的下一次约会计划&lt;/h2&gt; &lt;p&gt;这是一张蓝蓝的、带小狗祝福的计划卡片。&lt;/p&gt; &lt;div class=3D"planCard" id=3D"planCard"&gt;&lt;/div&gt; &lt;p style=3D"margin-top:12px;"&gt; 给你的话：其实不是为了和你决定吃什么，而是我想告诉你，我期待每一次我们的见面。 &lt;/p&gt; &lt;div class=3D"smallLinks"&gt; &lt;button id=3D"copyLinkBtn"&gt;复制分享链接&lt;/button&gt; &lt;button id=3D"openLetterBtn2"&gt;隐藏情书&lt;/button&gt; &lt;/div&gt; &lt;button class=3D"btn secondary" id=3D"restart"&gt;重新定制一次&lt;/button&gt; &lt;div class=3D"progress" aria-hidden=3D"true"&gt; &lt;div class=3D"dot on"&gt;&lt;/div&gt;&lt;div class=3D"dot on"&gt;&lt;/div&gt;&lt;div class=3D"dot on"&gt;&lt;/div&gt;&lt;div class=3D"dot on"&gt;&lt;/div&gt;&lt;div class=3D"dot on"&gt;&lt;/div&gt; &lt;/div&gt; &lt;/div&gt; &lt;/div&gt; &lt;!-- Hidden Love Letter Page (not counted in 5) --&gt; &lt;div class=3D"page" id=3D"letter"&gt; &lt;div class=3D"card"&gt; &lt;h2&gt;隐藏情书（小狗版）&lt;/h2&gt; &lt;p style=3D"color:#17314d"&gt; 我做这个小页面，不是为了把我们安排得更满，&lt;br&gt; 是想把“见你”变成一件更确定的事。&lt;br&gt;&lt;br&gt; 你选南宁还是西宁、浪漫还是安静、火锅还是甜品，&lt;br&gt; 我都喜欢。因为我喜欢的是：你。&lt;br&gt;&lt;br&gt;&nbsp;</span><span style=3D"mso-spacerun:'yes';font-family:'Apple Color Emoji';color:rgb(0,0,0);=20letter-spacing:0.0000pt;text-transform:none;font-style:normal;=20font-size:10.5000pt;mso-font-kerning:0.0000pt;" ><font face=3D"Apple Color Emoji" >&#55357;&#56382;</font></span><span style=3D"mso-spacerun:'yes';font-family:-webkit-standard;color:rgb(0,0,0);=20letter-spacing:0.0000pt;text-transform:none;font-style:normal;=20font-size:13.5000pt;mso-font-kerning:0.0000pt;" >&nbsp;小狗也同意：下一次见面要超级开心。 &lt;/p&gt; &lt;button class=3D"btn" id=3D"backFromLetter"&gt;回到计划&lt;/button&gt; &lt;/div&gt; &lt;/div&gt; &lt;/div&gt; &lt;div class=3D"toast" id=3D"toast"&gt;已记录成功&lt;/div&gt; &lt;script&gt; // --- 2-minute flow timer (soft) --- let total =3D 120; // seconds let timerEl =3D document.getElementById('timer'); let timerId =3D setInterval(() =3D&gt; { total--; if (total &lt; 0) { clearInterval(timerId); return; } const m =3D Math.floor(total/60); const s =3D String(total%60).padStart(2,'0'); timerEl.textContent =3D `${m}:${s}`; if (total =3D=3D=3D 0) showToast("时间到啦～但我们还可以继续慢慢选"); }, 1000); // --- Pages --- const pages =3D ["p1","p2","p3","p4","p5","letter"]; const show =3D (id) =3D&gt; { pages.forEach(pid =3D&gt; document.getElementById(pid).classList.remove('on')); document.getElementById(id).classList.add('on'); window.scrollTo({ top: 0, behavior: 'smooth' }); }; // --- 首页泡泡动画 --- const bubbleBox =3D document.getElementById('bubbleBox'); function spawnBubbles(){ bubbleBox.innerHTML =3D ""; const count =3D 18; for(let i=3D0;i&lt;count;i++){ const b =3D document.createElement('div'); b.className =3D "bubble"; b.style.left =3D Math.random()*100 + "%"; b.style.bottom =3D (-20 - Math.random()*60) + "px"; b.style.animationDelay =3D (Math.random()*2.8) + "s"; b.style.animationDuration =3D (4.4 + Math.random()*2.8) + "s"; b.style.width =3D (10 + Math.random()*14) + "px"; b.style.height =3D b.style.width; b.style.background =3D `rgba(47,128,255,${0.12 + Math.random()*0.22})`; bubbleBox.appendChild(b); } } spawnBubbles(); // --- State --- const state =3D { month:null, day:null, theme:null, place:null, food:null }; // --- Date constraints: 2026-09+ --- const monthSel =3D document.getElementById('monthSel'); const daySel =3D document.getElementById('daySel'); function fillMonths(){ const months =3D []; for(let y=3D2026; y&lt;=3D2028; y++){ for(let m=3D1; m&lt;=3D12; m++){ if(y=3D=3D=3D2026 && m&lt;9) continue; months.push({y,m}); } } monthSel.innerHTML =3D months.map(({y,m})=3D&gt;{ const mm =3D String(m).padStart(2,'0'); return `&lt;option value=3D"${y}-${mm}"&gt;${y}年${mm}月&lt;/option&gt;`; }).join(""); } function daysInMonth(y,m){ return new Date(y, m, 0).getDate(); } function fillDays(){ const [y,mm] =3D monthSel.value.split("-"); const yNum =3D Number(y), mNum =3D Number(mm); const n =3D daysInMonth(yNum, mNum); daySel.innerHTML =3D Array.from({length:n}, (_,i)=3D&gt;{ const d =3D String(i+1).padStart(2,'0'); return `&lt;option value=3D"${d}"&gt;${d}日&lt;/option&gt;`; }).join(""); } fillMonths(); fillDays(); monthSel.addEventListener('change', fillDays); // --- Option selection helpers (single choice) --- function bindOptions(containerId, key){ const box =3D document.getElementById(containerId); box.addEventListener('click', (e)=3D&gt;{ const opt =3D e.target.closest('.opt'); if(!opt) return; [...box.querySelectorAll('.opt')].forEach(x=3D&gt;x.classList.remove('active')); opt.classList.add('active'); state[key] =3D opt.dataset.val; }); } bindOptions("themeOpts", "theme"); bindOptions("placeOpts", "place"); bindOptions("foodOpts", "food"); // --- Toast --- const toast =3D document.getElementById('toast'); let toastT =3D null; function showToast(msg){ toast.textContent =3D msg; toast.classList.add('show'); clearTimeout(toastT); toastT =3D setTimeout(()=3D&gt;toast.classList.remove('show'), 1600); } // --- Hidden letter triggers --- let tapCount =3D 0; const titleTap =3D document.getElementById('titleTap'); const openLetterBtn =3D document.getElementById('openLetterBtn'); titleTap.addEventListener('click', ()=3D&gt;{ tapCount++; if(tapCount &gt;=3D 5){ openLetterBtn.style.display =3D "block"; showToast("你发现了隐藏情书"); tapCount =3D 0; } }); // --- Build plan card --- function renderPlan(){ const dateText =3D (state.month && state.day) ? `${state.month}-${state.day}` : "（未选择）"; const themeText =3D state.theme || "（未选择）"; const placeText =3D state.place || "（未选择）"; const foodText =3D state.food || "（未选择）"; document.getElementById('planCard').innerHTML =3D ` &lt;div class=3D"kv"&gt;&lt;div class=3D"k"&gt;约会时间&lt;/div&gt;&lt;div class=3D"v"&gt;${dateText}&lt;/div&gt;&lt;/div&gt; &lt;div class=3D"kv"&gt;&lt;div class=3D"k"&gt;约会感觉&lt;/div&gt;&lt;div class=3D"v"&gt;${themeText}&lt;/div&gt;&lt;/div&gt; &lt;div class=3D"kv"&gt;&lt;div class=3D"k"&gt;约会地点&lt;/div&gt;&lt;div class=3D"v"&gt;${placeText}&lt;/div&gt;&lt;/div&gt; &lt;div class=3D"kv"&gt;&lt;div class=3D"k"&gt;用餐菜系&lt;/div&gt;&lt;div class=3D"v"&gt;${foodText}&lt;/div&gt;&lt;/div&gt; `; } // --- Share link with URL params --- function buildShareUrl(){ const u =3D new URL(location.href); u.searchParams.set("m", state.month || ""); u.searchParams.set("d", state.day || ""); u.searchParams.set("t", state.theme || ""); u.searchParams.set("p", state.place || ""); u.searchParams.set("f", state.food || ""); u.searchParams.set("v", "2"); return u.toString(); } async function copyToClipboard(text){ try{ await navigator.clipboard.writeText(text); showToast("分享链接已复制"); }catch(err){ const ta =3D document.createElement('textarea'); ta.value =3D text; document.body.appendChild(ta); ta.select(); document.execCommand('copy'); ta.remove(); showToast("分享链接已复制"); } } // --- Restore from URL params --- (function restoreFromUrl(){ const u =3D new URL(location.href); if(u.searchParams.get("v") !=3D=3D "2") return; const m =3D u.searchParams.get("m") || null; const d =3D u.searchParams.get("d") || null; const t =3D u.searchParams.get("t") || null; const p =3D u.searchParams.get("p") || null; const f =3D u.searchParams.get("f") || null; if(m){ state.month =3D m; monthSel.value =3D m; fillDays(); } if(d){ state.day =3D d; daySel.value =3D d; } if(t){ state.theme =3D t; } if(p){ state.place =3D p; } if(f){ state.food =3D f; } // Reflect option UI if(t){ document.querySelectorAll('#themeOpts .opt').forEach(el=3D&gt;{ el.classList.toggle('active', el.dataset.val =3D=3D=3D t); }); } if(p){ document.querySelectorAll('#placeOpts .opt').forEach(el=3D&gt;{ el.classList.toggle('active', el.dataset.val =3D=3D=3D p); }); } if(f){ document.querySelectorAll('#foodOpts .opt').forEach(el=3D&gt;{ el.classList.toggle('active', el.dataset.val =3D=3D=3D f); }); } renderPlan(); if(m && d && t && p && f){ showToast("已从分享链接恢复计划"); show("p5"); } })(); // --- Navigation buttons --- document.getElementById('startBtn').addEventListener('click', ()=3D&gt; show("p2")); document.getElementById('saveDateBtn').addEventListener('click', ()=3D&gt;{ state.month =3D monthSel.value; state.day =3D daySel.value; showToast("记录成功"); show("p3"); }); document.getElementById('toP4').addEventListener('click', ()=3D&gt;{ if(!state.theme){ showToast("先选一个你想要的感觉"); return; } show("p4"); }); document.getElementById('toP5').addEventListener('click', ()=3D&gt;{ if(!state.place){ showToast("先选一个约会地点"); return; } if(!state.food){ showToast("先选一个菜系"); return; } renderPlan(); show("p5"); }); document.getElementById('back1').addEventListener('click', ()=3D&gt; show("p1")); document.getElementById('back2').addEventListener('click', ()=3D&gt; show("p2")); document.getElementById('back3').addEventListener('click', ()=3D&gt; show("p3")); document.getElementById('restart').addEventListener('click', ()=3D&gt;{ state.month=3Dnull; state.day=3Dnull; state.theme=3Dnull; state.place=3Dnull; state.food=3Dnull; fillMonths(); fillDays(); document.querySelectorAll('.opt').forEach(x=3D&gt;x.classList.remove('active')); spawnBubbles(); showToast("已重新开始"); show("p1"); }); document.getElementById('copyLinkBtn').addEventListener('click', ()=3D&gt;{ copyToClipboard(buildShareUrl()); }); // Hidden love letter navigation const goLetter =3D ()=3D&gt; show("letter"); document.getElementById('openLetterBtn').addEventListener('click', goLetter); document.getElementById('openLetterBtn2').addEventListener('click', goLetter); document.getElementById('backFromLetter').addEventListener('click', ()=3D&gt;{ if(state.month && state.day && state.theme && state.place && state.food) show("p5"); else show("p1"); }); &lt;/script&gt; &lt;/body&gt; &lt;/html&gt;</span><span style=3D"mso-spacerun:'yes';font-family:Calibri;mso-fareast-font-family:宋体;=20mso-bidi-font-family:'Times New Roman';font-size:10.5000pt;mso-font-kerning:1.0000pt;" ><o:p></o:p></span></p><p class=3DMsoNormal ><span style=3D"mso-spacerun:'yes';font-family:Calibri;mso-fareast-font-family:宋体;=20mso-bidi-font-famil